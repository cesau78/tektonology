# Auth0 authentication (from https://manage.auth0.com)
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_client_id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.tektonology.com

# FinOps API URL (default: http://localhost:3001)
NEXT_PUBLIC_FINOPS_API_URL=http://localhost:3001
