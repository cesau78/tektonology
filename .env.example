# Shared environment config — copy to .env and fill in values
# Services load this via services/shared/env.js
# Service-specific overrides go in services/<name>/.env

# Printer (used by printing-agent, print-proxy)
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=

# MongoDB (used by printing-agent, accounting-agent)
MONGODB_URI=mongodb://localhost:27017/tektonology
DB_NAME=tektonology

# Redis (used by agent-bus → printing-agent, accounting-agent)
REDIS_URL=redis://localhost:6379
