# Tektonology — all environment config
# Copy to .env.local and fill in values

# ── Printer (printing-agent, print-proxy, studio-proxy) ──
PRINTER_IP=
PRINTER_SERIAL=
PRINTER_ACCESS_CODE=

# ── MongoDB (api, printing-agent, accounting-agent, mqtt-dashboard) ──
MONGODB_URI=mongodb://localhost:27017/tektonology
DB_NAME=tektonology

# ── Redis (agent-bus) ──
REDIS_URL=redis://localhost:6379

# ── Auth0 (api + spa) ──
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.tektonology.com
AUTH0_CLIENT_ID=your_client_id
API_PORT=3001

# ── Service-specific ──
ACTIVE_SPOOL_ID=
DASHBOARD_PORT=3000
PROXY_PORT=18883
PROXY_HOST=
STUDIO_PROXY_PORT=28883
